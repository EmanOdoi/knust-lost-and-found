PORT=4000
JWT_SECRET=change-this-to-a-long-random-string

# Optional: absolute path for the SQLite database. Leave unset locally.
# With a Render disk mounted at /var/data, set:
# DATABASE_PATH=/var/data/lostfound.db
DATABASE_PATH=

# Optional: enables email notifications on claim submit/approve/reject.
# Sign up free at resend.com, create an API key, and paste it below.
# If left blank, the app runs fine — it just logs "would have sent" instead.
RESEND_API_KEY=
EMAIL_FROM=KNUST Lost & Found <onboarding@resend.dev>
